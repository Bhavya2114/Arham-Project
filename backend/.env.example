PORT=3000
MONGODB_URI="mongodb://127.0.0.1:27017/inventory_management"

JWT_SECRET="your-super-cryptographic-jwt-secret-phrase"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
FRONTEND_URL="https://arham-inventory-frontend.vercel.app"

# ==============================================================================
# Gemini AI Configuration & Automatic Key Rotation
# ==============================================================================
# Configure two or more API keys to enable automatic rotation and failover when
# rate limits (HTTP 429 / RESOURCE_EXHAUSTED) or quota exhaustion occurs.
# You can add unlimited future keys by continuing the numeric suffix (GEMINI_API_KEY_3, etc.).
# No code changes are required for additional keys.
GEMINI_API_KEY_1="your_first_gemini_api_key"
GEMINI_API_KEY_2="your_second_gemini_api_key"
# GEMINI_API_KEY_3="your_third_gemini_api_key"
# GEMINI_API_KEY_4="your_fourth_gemini_api_key"

# (Optional) Legacy single key fallback:
# GEMINI_API_KEY="your_single_gemini_api_key"

# Gemini model to use for purchase bill extraction (default: gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"

# (Optional) Temporary cooldown duration in seconds when a key encounters quota limits (default: 60)
GEMINI_KEY_COOLDOWN_SECONDS=60

# ==============================================================================
# Render API Automation Credentials (Optional - for npm run gemini:keys CLI)
# ==============================================================================
# Generate token at: Render Dashboard -> Account Settings -> API Keys
RENDER_API_KEY="your_render_api_token"
# Found in your backend service dashboard URL (e.g. srv-xxxxxxxxxxxxxxxxxxxx)
RENDER_SERVICE_ID="your_render_backend_service_id"

# "Back up now" button: starts the GitHub Actions backup and downloads the same .gz
# Fine-grained token with Actions: read & write on the backup repo only
GITHUB_BACKUP_TOKEN=""
GITHUB_BACKUP_REPO="Bhavya2114/arham-db-backup"
GITHUB_BACKUP_WORKFLOW="backup.yml"
